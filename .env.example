# --- LLM: auto | bedrock | offline (offline = no cloud, rule-based) ---
CARECIRCLE_LLM=auto
AWS_REGION=us-east-1
CARECIRCLE_FAST_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
CARECIRCLE_SMART_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# --- Storage: sqlite | dynamodb ---
CARECIRCLE_STORAGE=sqlite
CARECIRCLE_DYNAMO_TABLE=carecircle

# --- Family alerts via Amazon SNS (SMS/email). Leave empty for dashboard-only ---
CARECIRCLE_SNS_TOPIC_ARN=

# --- Server ---
HOST=127.0.0.1
PORT=8000
CARECIRCLE_TZ=Asia/Kolkata
# Protect /mcp with a bearer token when exposed publicly
CARECIRCLE_API_TOKEN=

# --- Backup LLM (OpenAI-compatible) if Bedrock is unavailable ---
# OpenAI:  OPENAI_BASE_URL=https://api.openai.com/v1   CARECIRCLE_OPENAI_MODEL=gpt-4o-mini
# Gemini:  OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   CARECIRCLE_OPENAI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CARECIRCLE_OPENAI_MODEL=gpt-4o-mini
